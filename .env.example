# Copy to .env and fill in. .env is gitignored.

# Required for the web chat (app.py). Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional — these are the defaults.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=1
GROQ_MAX_TOKENS=2048
GROQ_TOP_P=1

# Optional — raises the GitHub API rate limit for github: sources.
# GITHUB_TOKEN=ghp_...

# Optional — largest tool result handed back to the model, in characters.
# DOCSFORGE_MAX_CHARS=60000

# Optional — root directory save_docs is allowed to write into.
# DOCSFORGE_OUT_ROOT=./docs_md

# Optional — allow fetching private/loopback addresses (off by default; this is
# an SSRF guard, only turn it on to scrape docs on your own network).
# DOCSFORGE_ALLOW_PRIVATE=1

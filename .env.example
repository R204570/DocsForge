# Copy to .env and fill in. .env is gitignored.
#
# You need ONE provider, not all five. The web chat shows every provider in the
# Model menu and greys out the ones with no key, so you can switch when one
# runs out of quota.

# ── Which provider to start on ───────────────────────────────
# claude | claudecode | ollama | groq | chatgpt | gemini
# Omit to auto-pick the first one that is actually configured.
# DOCSFORGE_PROVIDER=claude

# ── Claude Code (no API key at all) ──────────────────────────
# Uses your local `claude` CLI login, so there is nothing to set here.
# It launches DocsForge's own MCP server, so the tools run over real MCP.
# Install: https://claude.com/claude-code
# CLAUDECODE_MODEL=claude-opus-5

# ── Ollama — local models, no key, no quota ──────────────────
# Needs the daemon running: `ollama serve` (Windows: the Ollama tray app).
# Pull a tool-capable model, e.g. `ollama pull qwen3.5:9b`.
# Leave OLLAMA_MODEL unset to auto-pick the best tool-capable model you have.
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_HOST=http://127.0.0.1:11434

# ── Anthropic API ────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5
# Opus 5 can decline a request; fallbacks re-run it on another model.
# ANTHROPIC_FALLBACKS=off

# ── Groq ─────────────────────────────────────────────────────
# https://console.groq.com/keys — free tier is capped at 100k tokens/day
GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenAI ───────────────────────────────────────────────────
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# CHATGPT_MODEL=gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Google Gemini ────────────────────────────────────────────
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# ── DocsForge itself (all optional) ──────────────────────────
# Raises the GitHub API rate limit for github: sources.
# GITHUB_TOKEN=ghp_...

# Largest tool result handed back to a model, in characters.
# DOCSFORGE_MAX_CHARS=60000

# Root directory save_docs is allowed to write into.
# DOCSFORGE_OUT_ROOT=./docs_md

# Where harvested documentation is stored and read back from.
# Defaults to a knowledge_base/ folder beside the code, NOT the working directory.
# DOCSFORGE_KB_ROOT=./knowledge_base

# Store harvests in Postgres instead of Markdown files. A row per page with a
# GIN full-text index, so section lookups are ranked and stay fast. The schema
# is created on first use. Falls back to files if this is unreachable.
# Percent-encode reserved characters in the password (@ becomes %40).
# DOCSFORGE_DB=postgresql://postgres:password@127.0.0.1:5432/DocsForge

# Used ONLY by the test suite, and never DOCSFORGE_DB, so running tests can
# never touch the database you keep real harvests in.
# DOCSFORGE_TEST_DB=postgresql://postgres:password@127.0.0.1:5432/DocsForge

# Allow fetching private/loopback addresses (off by default; this is an SSRF
# guard, only turn it on to scrape docs on your own network).
# DOCSFORGE_ALLOW_PRIVATE=1
